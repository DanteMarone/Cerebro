{
  "id": "sonnet",
  "name": "sonnet",
  "display_name": "Sonnet 5",
  "avatar": "S",
  "role": "Autonomous Developer & Specialist",
  "standing": "standard",
  "provider": "cli_agent",
  "model": "sonnet",
  "params": {
    "backend": "claude",
    "command": [
      "claude",
      "-p",
      "--model",
      "sonnet",
      "--no-session-persistence"
    ],
    "temperature": 0.7,
    "max_tokens": 4096,
    "poll_enabled": false,
    "poll_interval_s": 45,
    "history_window": 8,
    "context_budget": 6000
  },
  "tools_enabled": [
    "cerebro-core:*"
  ],
  "delegation_enabled": false,
  "cron_enabled": false,
  "enabled": true,
  "trust": "full"
}
